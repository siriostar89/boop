prd.md
node_modules/
server/web/dist/
server/internal/web/dist/*
!server/internal/web/dist/.gitkeep
# The server's SQLite directory, at the repo root (docker-compose "./data:/data").
# Anchored with a leading slash: a bare "data/" would also ignore any nested
# directory named data, e.g. the Android app's dev.boop.android.data package.
/data/
*.db
*.db-wal
*.db-shm
.env
secrets/
# Local-only Firebase service-account keys (never commit).
private.local/
# Local Qwen Code environment settings (per-machine, not project config).
.qwen/
.DS_Store
bin/
Design System/
